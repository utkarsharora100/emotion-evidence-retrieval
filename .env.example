# Optional Kaggle API credentials. Prefer KAGGLE_API_TOKEN for modern clients,
# or place a kaggle.json in the standard Kaggle location.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# SPLADE model. This is intentionally not replaced by BM25 if unavailable.
SPLADE_MODEL=naver/splade-cocondenser-ensembledistil

# Optional remote Qdrant; default is local in-memory Qdrant.
QDRANT_URL=
QDRANT_API_KEY=

# Optional answer generation. Without this, the RAG CLI uses extractive mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
